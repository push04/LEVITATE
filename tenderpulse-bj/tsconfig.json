{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["scrapers", "ai", "alerts", "db", "server"],
  "exclude": ["scrapers/probes", "node_modules", "dashboard"]
}
